---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from './Breadcrumb.astro';
import ServiceIcon from './ServiceIcon.astro';
import ServiceImage from './ServiceImage.astro';
import CTASection from './CTASection.astro';
import FAQ from './FAQ.astro';
import SectionHeading from './SectionHeading.astro';
import { SITE, TV_REPAIR_BRANDS, TV_REPAIR_FAQS, CITIES, ALL_BLOG_POSTS as BLOG_POSTS, BRAND_PAGES } from '../data/site';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const tv = TV_REPAIR_BRANDS.find((t) => t.slug === slug);
if (!tv) throw new Error(`TV repair brand not found: ${slug}`);

const faqKey = tv.brandEn.toLowerCase();
const faqs = TV_REPAIR_FAQS[faqKey] || [];

const relatedPosts = BLOG_POSTS.filter((p) => p.category === 'تلویزیون').slice(0, 3);
const brandPage = BRAND_PAGES.find((b) => b.nameEn.toLowerCase() === tv.brandEn.toLowerCase());
const otherTvBrands = TV_REPAIR_BRANDS.filter((t) => t.slug !== slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `تعمیر تلویزیون ${tv.brand}`,
  description: tv.metaDescription,
  provider: { '@type': 'LocalBusiness', name: 'آمل سرویس', telephone: SITE.phone },
  areaServed: CITIES.map((c) => c.name),
};
---

<Layout title={tv.seoTitle} description={tv.metaDescription} jsonLd={jsonLd}>
  <Breadcrumb items={[{ label: 'تعمیر تلویزیون', href: '/repair-tv-amol/' }, { label: tv.brand }]} />

  <section class="container-app pt-6 md:pt-8">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
      <div class="space-y-5">
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary text-white shadow-lg">
          <ServiceIcon name="tv" class="h-8 w-8" />
        </div>
        <h1 class="text-2xl font-extrabold leading-tight text-foreground md:text-3xl lg:text-4xl">{tv.h1}</h1>
        <p class="text-base leading-relaxed text-muted-foreground md:text-lg">{tv.intro}</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href={SITE.telLink} class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-5 py-3 text-sm font-bold text-white shadow-md transition-colors hover:bg-orange-600">
            <ServiceIcon name="phone" class="h-4 w-4" />
            تماس با آمل سرویس: <span dir="ltr">{SITE.phoneDisplay}</span>
          </a>
          <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-green-200 bg-green-50 px-5 py-3 text-sm font-bold text-green-700 transition-colors hover:bg-green-100">
            <ServiceIcon name="whatsapp" class="h-4 w-4" />
            واتساپ
          </a>
        </div>
      </div>
      <div class="rounded-2xl border border-border bg-muted/30 p-6">
        <ServiceImage type="tv" alt={`تعمیر تلویزیون ${tv.brand} در آمل`} class="h-[280px] w-full md:h-[320px]" />
      </div>
    </div>
  </section>

  <section class="bg-muted/50 py-12 md:py-16">
    <div class="container-app">
      <SectionHeading title={`مشکلات متداول تلویزیون ${tv.brand}`} subtitle="شایع‌ترین خرابی‌هایی که در تلویزیون‌های این برند دیده می‌شود" />
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {tv.problems.map((problem) => (
          <div class="flex items-start gap-3 rounded-lg border border-border bg-card p-4 shadow-sm">
            <ServiceIcon name="alert-triangle" class="mt-0.5 h-5 w-5 flex-shrink-0 text-accent" />
            <p class="text-sm leading-relaxed text-muted-foreground">{problem}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-app section-pad">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div class="rounded-xl border border-blue-200 bg-blue-50 p-6">
        <div class="mb-4 flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-700">
            <ServiceIcon name="search" class="h-5 w-5" />
          </div>
          <h2 class="text-xl font-bold text-foreground">بررسی‌هایی که خودتان می‌توانید انجام دهید</h2>
        </div>
        <ul class="space-y-3">
          {tv.selfCheck.map((item) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-foreground/80">
              <ServiceIcon name="check-circle" class="mt-0.5 h-4 w-4 flex-shrink-0 text-green-600" />
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-xl border border-orange-200 bg-orange-50 p-6">
        <div class="mb-4 flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-orange-100 text-orange-600">
            <ServiceIcon name="shield" class="h-5 w-5" />
          </div>
          <h2 class="text-xl font-bold text-foreground">نکات فنی تلویزیون {tv.brand}</h2>
        </div>
        <p class="text-sm leading-relaxed text-foreground/80">{tv.notes}</p>
        <div class="mt-4 border-t border-orange-200 pt-4">
          <h3 class="mb-2 text-sm font-bold text-foreground">چه زمانی نیاز به تکنسین دارید؟</h3>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-muted-foreground">
              <ServiceIcon name="wrench" class="mt-0.5 h-4 w-4 flex-shrink-0 text-accent" />
              تعویض LED strips بک‌لایت
            </li>
            <li class="flex items-start gap-2 text-sm text-muted-foreground">
              <ServiceIcon name="wrench" class="mt-0.5 h-4 w-4 flex-shrink-0 text-accent" />
              تعویض یا تعمیر بورد تغذیه
            </li>
            <li class="flex items-start gap-2 text-sm text-muted-foreground">
              <ServiceIcon name="wrench" class="mt-0.5 h-4 w-4 flex-shrink-0 text-accent" />
              تعویض بورد اصلی (Main Board)
            </li>
            <li class="flex items-start gap-2 text-sm text-muted-foreground">
              <ServiceIcon name="wrench" class="mt-0.5 h-4 w-4 flex-shrink-0 text-accent" />
              تعویض بورد T-Con
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <FAQ items={faqs} title={`سوالات متداول درباره تعمیر تلویزیون ${tv.brand}`} />

  <section class="bg-muted/50 py-12 md:py-16">
    <div class="container-app space-y-8">
      <div>
        <h2 class="mb-5 text-xl font-bold text-foreground md:text-2xl">صفحات مرتبط</h2>
        <div class="flex flex-wrap gap-3">
          <a href="/repair-tv-amol/" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground/80 transition-colors hover:border-secondary hover:text-secondary">
            <ServiceIcon name="tv" class="h-4 w-4" />
            تعمیر تلویزیون (همه برندها)
          </a>
          {brandPage && (
            <a href={`/brands/${brandPage.slug}/`} class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground/80 transition-colors hover:border-secondary hover:text-secondary">
              <ServiceIcon name="tv" class="h-4 w-4" />
              تعمیر لوازم خانگی {tv.brand}
            </a>
          )}
        </div>
      </div>

      {relatedPosts.length > 0 && (
        <div>
          <h2 class="mb-5 text-xl font-bold text-foreground md:text-2xl">مقالات مرتبط</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map((post) => (
              <a href={`/blog/${post.slug}/`} class="group flex flex-col overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all hover:shadow-md">
                <div class="aspect-[3/2] bg-primary/5">
                  <ServiceImage type={post.image} alt={post.title} class="h-full w-full" />
                </div>
                <div class="p-4">
                  <span class="text-xs font-semibold text-secondary">{post.category}</span>
                  <h3 class="mt-1 text-sm font-bold text-foreground group-hover:text-secondary">{post.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <div>
        <h2 class="mb-5 text-xl font-bold text-foreground md:text-2xl">تعمیر تلویزیون برندهای دیگر</h2>
        <div class="flex flex-wrap gap-3">
          {otherTvBrands.map((t) => (
            <a href={`/${t.slug}/`} class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground/80 transition-colors hover:border-secondary hover:text-secondary">
              <ServiceIcon name="tv" class="h-4 w-4" />
              {t.brand}
            </a>
          ))}
        </div>
      </div>

      <div>
        <h2 class="mb-5 text-xl font-bold text-foreground md:text-2xl">مناطق تحت پوشش</h2>
        <div class="flex flex-wrap gap-3">
          {CITIES.map((city) => (
            <a href={`/${city.slug}/`} class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground/80 transition-colors hover:border-secondary hover:text-secondary">
              <ServiceIcon name="map-pin" class="h-4 w-4" />
              {city.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title={`آیا تلویزیون ${tv.brand} شما نیاز به تعمیر دارد؟`}
    description="همین حالا تماس بگیرید یا در واتساپ پیام بدهید تا درخواست تعمیر شما ثبت شود."
  />
</Layout>
