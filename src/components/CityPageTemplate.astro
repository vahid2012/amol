---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from './Breadcrumb.astro';
import ServiceIcon from './ServiceIcon.astro';
import ServiceImage from './ServiceImage.astro';
import ServiceCard from './ServiceCard.astro';
import CTASection from './CTASection.astro';
import FAQ from './FAQ.astro';
import SectionHeading from './SectionHeading.astro';
import { SITE, SERVICES, CITIES, FAQS_CITY } from '../data/site';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const city = CITIES.find((c) => c.slug === slug);
if (!city) throw new Error(`City not found: ${slug}`);

const nearbyCities = city.nearbyCities
  .map((s) => CITIES.find((c) => c.slug === s))
  .filter(Boolean);

const cityFaqs = FAQS_CITY.map((f) => ({
  q: f.q.replace(/\{city\}/g, city.name),
  a: f.a.replace(/\{city\}/g, city.name),
}));

const cityServicesIntro = `در ${city.name}، لوازم خانگی مانند یخچال، لباسشویی، کولر گازی، پکیج، تلویزیون و مایکروویو ممکن است به‌دلیل استفاده مداوم، نوسانات برق یا فرسودگی قطعات دچار خرابی شوند. آمل سرویس عیب‌یابی و تعمیر این دستگاه‌ها را در ${city.name} و مناطق اطراف ارائه می‌دهد.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `تعمیر لوازم خانگی در ${city.name}`,
  description: city.metaDescription,
  provider: {
    '@type': 'LocalBusiness',
    name: 'آمل سرویس',
    telephone: SITE.phone,
  },
  areaServed: city.name,
};
---

<Layout
  title={city.seoTitle}
  description={city.metaDescription}
  jsonLd={jsonLd}
>
  <Breadcrumb items={[{ label: 'مناطق تحت پوشش', href: '/#areas' }, { label: city.name }]} />

  <!-- Hero -->
  <section class="container-app pt-6 md:pt-8">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
      <div class="space-y-5">
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary text-white shadow-lg">
          <ServiceIcon name="map-pin" class="h-8 w-8" />
        </div>
        <h1 class="text-2xl font-extrabold leading-tight text-foreground md:text-3xl lg:text-4xl">
          تعمیر لوازم خانگی در {city.name}
        </h1>
        <p class="text-base leading-relaxed text-muted-foreground md:text-lg">{city.description}</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href={SITE.telLink} class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-5 py-3 text-sm font-bold text-white shadow-md transition-colors hover:bg-orange-600">
            <ServiceIcon name="phone" class="h-4 w-4" />
            تماس با آمل سرویس: <span dir="ltr">{SITE.phoneDisplay}</span>
          </a>
          <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-green-200 bg-green-50 px-5 py-3 text-sm font-bold text-green-700 transition-colors hover:bg-green-100">
            <ServiceIcon name="whatsapp" class="h-4 w-4" />
            واتساپ
          </a>
        </div>
      </div>
      <div class="rounded-2xl border border-border bg-muted/30 p-6">
        <ServiceImage type="city" alt={`تعمیر لوازم خانگی در ${city.name}`} class="h-[280px] w-full md:h-[320px]" />
      </div>
    </div>
  </section>

  <!-- Services in this city -->
  <section class="container-app section-pad">
    <SectionHeading
      title={`خدمات تعمیر در ${city.name}`}
      subtitle={cityServicesIntro}
    />
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {SERVICES.map((service) => (
        <ServiceCard
          title={`${service.title} در ${city.name}`}
          short={service.short}
          href={`/${service.slug}/`}
          icon={service.icon}
        />
      ))}
    </div>
  </section>

  <!-- Common Problems -->
  <section class="bg-muted/50 py-12 md:py-16">
    <div class="container-app">
      <SectionHeading
        title={`مشکلات متداول لوازم خانگی در ${city.name}`}
        subtitle={`شایع‌ترین خرابی‌هایی که ساکنان ${city.name} ممکن است با آن‌ها روبرو شوند`}
      />
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {SERVICES.map((service) => (
          <div class="rounded-lg border border-border bg-card p-5 shadow-sm">
            <div class="mb-3 flex items-center gap-2.5">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/5 text-primary">
                <ServiceIcon name={service.icon} class="h-5 w-5" />
              </div>
              <h3 class="text-sm font-bold text-foreground">{service.title}</h3>
            </div>
            <ul class="space-y-2">
              {service.symptoms.slice(0, 3).map((symptom) => (
                <li class="flex items-start gap-2 text-xs leading-relaxed text-muted-foreground">
                  <span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-full bg-accent"></span>
                  {symptom}
                </li>
              ))}
            </ul>
            <a href={`/${service.slug}/`} class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-secondary">
              اطلاعات بیشتر
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How to Request -->
  <section class="container-app section-pad">
    <SectionHeading title={`نحوه ثبت درخواست تعمیر در ${city.name}`} subtitle="در سه مرحله ساده می‌توانید درخواست تعمیر دستگاه خود را ثبت کنید" />
    <div class="mx-auto max-w-3xl space-y-4">
      <div class="flex items-start gap-4 rounded-lg border border-border bg-card p-5 shadow-sm">
        <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-accent text-white">
          <ServiceIcon name="phone" class="h-5 w-5" />
        </div>
        <div>
          <h3 class="font-bold text-foreground">تماس یا پیام واتساپ</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted-foreground">با شماره {SITE.phoneDisplay} تماس بگیرید یا در واتساپ مشکل دستگاه خود را توضیح دهید. شهر و منطقه خود را نیز ذکر کنید.</p>
        </div>
      </div>
      <div class="flex items-start gap-4 rounded-lg border border-border bg-card p-5 shadow-sm">
        <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-secondary text-white">
          <ServiceIcon name="search" class="h-5 w-5" />
        </div>
        <div>
          <h3 class="font-bold text-foreground">هماهنگی و عیب‌یابی</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted-foreground">زمان مناسب برای رسیدن به محل در {city.name} هماهنگ می‌شود و دستگاه در محل عیب‌یابی می‌گردد.</p>
        </div>
      </div>
      <div class="flex items-start gap-4 rounded-lg border border-border bg-card p-5 shadow-sm">
        <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-primary text-white">
          <ServiceIcon name="wrench" class="h-5 w-5" />
        </div>
        <div>
          <h3 class="font-bold text-foreground">تعمیر و تحویل</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted-foreground">پس از اعلام هزینه و تأیید شما، تعمیر انجام می‌شود و دستگاه تست و تحویل داده می‌شود.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQ items={cityFaqs} title={`سوالات متداول درباره تعمیر لوازم خانگی در ${city.name}`} />

  <!-- Nearby Cities -->
  <section class="bg-muted/50 py-12 md:py-16">
    <div class="container-app">
      <SectionHeading title="شهرهای مجاور" subtitle="شهرهای نزدیک که در آن‌ها نیز خدمات ارائه می‌شود" />
      <div class="flex flex-wrap gap-3">
        {nearbyCities.map((nc) => nc && (
          <a href={`/${nc.slug}/`} class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground/80 transition-colors hover:border-secondary hover:text-secondary">
            <ServiceIcon name="map-pin" class="h-4 w-4" />
            تعمیر لوازم خانگی در {nc.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title={`درخواست تعمیر لوازم خانگی در ${city.name}`}
    description="برای ثبت درخواست تماس بگیرید یا در واتساپ پیام بدهید."
  />
</Layout>
