---
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  title: string;
  short: string;
  href: string;
  icon: string;
}

const { title, short, href, icon } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col items-start gap-4 rounded-xl border border-border bg-card p-6 shadow-sm transition-all hover:border-secondary/40 hover:shadow-md"
>
  <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-primary/5 text-primary transition-colors group-hover:bg-secondary/10 group-hover:text-secondary">
    <ServiceIcon name={icon} class="h-7 w-7" />
  </div>
  <div class="space-y-1.5">
    <h3 class="text-lg font-bold text-foreground group-hover:text-secondary">{title}</h3>
    <p class="text-sm leading-relaxed text-muted-foreground">{short}</p>
  </div>
  <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-accent">
    مشاهده و درخواست تعمیر
    <svg class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
    </svg>
  </span>
</a>
