---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from './Breadcrumb.astro';
import ServiceIcon from './ServiceIcon.astro';
import ServiceImage from './ServiceImage.astro';
import CTASection from './CTASection.astro';
import FAQ from './FAQ.astro';
import SectionHeading from './SectionHeading.astro';
import { SITE, SERVICES, CITIES, FAQS_SERVICES, BRANDS, ALL_BLOG_POSTS as BLOG_POSTS } from '../data/site';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const service = SERVICES.find((s) => s.slug === slug);
if (!service) throw new Error(`Service not found: ${slug}`);

const serviceKeyMap: Record<string, string> = {
  'repair-refrigerator-amol': 'refrigerator',
  'repair-washing-machine-amol': 'washing-machine',
  'repair-air-conditioner-amol': 'air-conditioner',
  'repair-package-amol': 'package',
  'repair-tv-amol': 'tv',
  'repair-microwave-amol': 'microwave',
};

const serviceKey = serviceKeyMap[slug] || 'refrigerator';
const faqs = FAQS_SERVICES[serviceKey as keyof typeof FAQS_SERVICES] || [];
const relatedPosts = BLOG_POSTS.filter((p) => p.image === serviceKey).slice(0, 3);
const otherServices = SERVICES.filter((s) => s.slug !== slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.metaDescription,
  provider: {
    '@type': 'LocalBusiness',
    name: 'آمل سرویس',
    telephone: SITE.phone,
  },
  areaServed: CITIES.map((c) => c.name),
};
---

<Layout
  title={service.seoTitle}
  description={service.metaDescription}
  jsonLd={jsonLd}
>
  <Breadcrumb items={[{ label: 'خدمات', href: '/#services' }, { label: service.title }]} />

  <!-- Hero -->
  <section class="container-app pt-6 md:pt-8">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
      <div class="space-y-5">
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary text-white shadow-lg">
          <ServiceIcon name={service.icon} class="h-8 w-8" />
        </div>
        <h1 class="text-2xl font-extrabold leading-tight text-foreground md:text-3xl lg:text-4xl">{service.h1}</h1>
        <p class="text-base leading-relaxed text-muted-foreground md:text-lg">{service.description}</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href={SITE.telLink} class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-5 py-3 text-sm font-bold text-white shadow-md transition-colors hover:bg-orange-600">
            <ServiceIcon name="phone" class="h-4 w-4" />
            تماس با آمل سرویس: <span dir="ltr">{SITE.phoneDisplay}</span>
          </a>
          <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-green-200 bg-green-50 px-5 py-3 text-sm font-bold text-green-700 transition-colors hover:bg-green-100">
            <ServiceIcon name="whatsapp" class="h-4 w-4" />
            واتساپ
          </a>
        </div>
      </div>
      <div class="rounded-2xl border border-border bg-muted/30 p-6">
        <ServiceImage type={service.icon} alt={`${service.title} در آمل و شهرهای اطراف`} class="h-[280px] w-full md:h-[320px]" />
      </div>
    </div>
  </section>

  <!-- Symptoms -->
  <section class="container-app section-pad">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      <div class="rounded-xl border border-border bg-card p-6 shadow-sm">
        <div class="mb-4 flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent/10 text-accent">
            <ServiceIcon name="alert-triangle" class="h-5 w-5" />
          </div>
          <h2 class="text-xl font-bold text-foreground">علائم خرابی دستگاه</h2>
        </div>
        <ul class="space-y-2.5">
          {service.symptoms.map((symptom) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted-foreground">
              <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent"></span>
              {symptom}
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-xl border border-border bg-card p-6 shadow-sm">
        <div class="mb-4 flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-secondary/10 text-secondary">
            <ServiceIcon name="info" class="h-5 w-5" />
          </div>
          <h2 class="text-xl font-bold text-foreground">مشکلات متداول</h2>
        </div>
        <ul class="space-y-2.5">
          {service.commonProblems.map((problem) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted-foreground">
              <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-secondary"></span>
              {problem}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Causes -->
  <section class="bg-muted/50 py-12 md:py-16">
    <div class="container-app">
      <SectionHeading title="علت‌های احتمالی خرابی" subtitle="شناختن علت‌های شایع به درک بهتر مشکل دستگاه کمک می‌کند" />
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {service.causes.map((cause, i) => (
          <div class="flex items-start gap-3 rounded-lg border border-border bg-card p-4 shadow-sm">
            <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-white">{i + 1}</span>
            <p class="text-sm leading-relaxed text-muted-foreground">{cause}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Diagnostic Process -->
  <section class="container-app section-pad">
    <SectionHeading title="فرآیند عیب‌یابی" subtitle="مراحل بررسی و تشخیص مشکل دستگاه به‌صورت اصولی" />
    <div class="mx-auto max-w-3xl space-y-3">
      {service.diagnosticProcess.map((step, i) => (
        <div class="flex items-start gap-4 rounded-lg border border-border bg-card p-4 shadow-sm">
          <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-secondary text-white">
            <span class="text-sm font-bold">{i + 1}</span>
          </div>
          <p class="pt-1 text-sm leading-relaxed text-foreground">{step}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Repair Services -->
  <section class="bg-muted/50 py-12 md:py-16">
    <div class="container-app">
      <SectionHeading title="خدمات تعمیر" subtitle="آنچه در فرآیند تعمیر دستگاه شما انجام می‌شود" />
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {service.needsTechnician.map((item) => (
          <div class="flex items-start gap-3 rounded-lg border border-border bg-card p-4 shadow-sm">
            <ServiceIcon name="check-circle" class="h-5 w-5 flex-shrink-0 text-green-600" />
            <p class="text-sm leading-relaxed text-foreground">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Safety & Self Check -->
  <section class="container-app section-pad">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div class="rounded-xl border border-orange-200 bg-orange-50 p-6">
        <div class="mb-4 flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-orange-100 text-orange-600">
            <ServiceIcon name="shield" class="h-5 w-5" />
          </div>
          <h2 class="text-xl font-bold text-foreground">نکات ایمنی</h2>
        </div>
        <ul class="space-y-3">
          {service.safetyTips.map((tip) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-foreground/80">
              <ServiceIcon name="alert-triangle" class="mt-0.5 h-4 w-4 flex-shrink-0 text-orange-500" />
              {tip}
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-xl border border-blue-200 bg-blue-50 p-6">
        <div class="mb-4 flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-700">
            <ServiceIcon name="search" class="h-5 w-5" />
          </div>
          <h2 class="text-xl font-bold text-foreground">قبل از تماس بررسی کنید</h2>
        </div>
        <p class="mb-4 text-sm text-muted-foreground">این موارد را خودتان می‌توانید بررسی کنید. اگر مشکل حل نشد، با ما تماس بگیرید:</p>
        <ul class="space-y-3">
          {service.selfCheck.map((item) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-foreground/80">
              <ServiceIcon name="check-circle" class="mt-0.5 h-4 w-4 flex-shrink-0 text-green-600" />
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQ items={faqs} title={`سوالات متداول درباره ${service.title}`} />

  <!-- Related Links -->
  <section class="bg-muted/50 py-12 md:py-16">
    <div class="container-app space-y-8">
      <!-- Related Articles -->
      {relatedPosts.length > 0 && (
        <div>
          <h2 class="mb-5 text-xl font-bold text-foreground md:text-2xl">مقالات مرتبط</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map((post) => (
              <a href={`/blog/${post.slug}/`} class="group flex flex-col overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all hover:shadow-md">
                <div class="aspect-[3/2] bg-primary/5">
                  <ServiceImage type={post.image} alt={post.title} class="h-full w-full" />
                </div>
                <div class="p-4">
                  <span class="text-xs font-semibold text-secondary">{post.category}</span>
                  <h3 class="mt-1 text-sm font-bold text-foreground group-hover:text-secondary">{post.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Related Cities -->
      <div>
        <h2 class="mb-5 text-xl font-bold text-foreground md:text-2xl">مناطق تحت پوشش این خدمت</h2>
        <div class="flex flex-wrap gap-3">
          {CITIES.map((city) => (
            <a href={`/${city.slug}/`} class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground/80 transition-colors hover:border-secondary hover:text-secondary">
              <ServiceIcon name="map-pin" class="h-4 w-4" />
              {service.title} در {city.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Related Brands -->
      <div>
        <h2 class="mb-5 text-xl font-bold text-foreground md:text-2xl">برندهای قابل تعمیر</h2>
        <div class="flex flex-wrap gap-3">
          {BRANDS.map((brand) => (
            <span class="rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium text-foreground/70">{brand}</span>
          ))}
        </div>
      </div>

      <!-- Other Services -->
      <div>
        <h2 class="mb-5 text-xl font-bold text-foreground md:text-2xl">سایر خدمات</h2>
        <div class="flex flex-wrap gap-3">
          {otherServices.map((s) => (
            <a href={`/${s.slug}/`} class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground/80 transition-colors hover:border-secondary hover:text-secondary">
              <ServiceIcon name={s.icon} class="h-4 w-4" />
              {s.title}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title={`آیا نیاز به ${service.title} دارید؟`}
    description="همین حالا تماس بگیرید یا در واتساپ پیام بدهید تا درخواست تعمیر شما ثبت شود."
  />
</Layout>
