---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-7 w-7' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {name === 'refrigerator' && (
    <>
      <rect x="5" y="2" width="14" height="20" rx="2" />
      <line x1="5" y1="10" x2="19" y2="10" />
      <line x1="9" y1="6" x2="9" y2="7" />
      <line x1="9" y1="14" x2="9" y2="15" />
    </>
  )}
  {name === 'washing-machine' && (
    <>
      <rect x="4" y="2" width="16" height="20" rx="2" />
      <circle cx="12" cy="14" r="5" />
      <circle cx="12" cy="14" r="2" />
      <line x1="7" y1="6" x2="7" y2="6" />
      <line x1="10" y1="6" x2="10" y2="6" />
      <line x1="13" y1="6" x2="13" y2="6" />
    </>
  )}
  {name === 'air-conditioner' && (
    <>
      <rect x="2" y="5" width="20" height="8" rx="2" />
      <line x1="6" y1="17" x2="6" y2="20" />
      <line x1="12" y1="17" x2="12" y2="22" />
      <line x1="18" y1="17" x2="18" y2="20" />
      <line x1="6" y1="9" x2="18" y2="9" />
    </>
  )}
  {name === 'package' && (
    <>
      <rect x="3" y="4" width="18" height="14" rx="2" />
      <circle cx="12" cy="11" r="3" />
      <line x1="7" y1="18" x2="7" y2="21" />
      <line x1="17" y1="18" x2="17" y2="21" />
      <line x1="9" y1="11" x2="9.01" y2="11" />
      <line x1="15" y1="11" x2="15.01" y2="11" />
    </>
  )}
  {name === 'tv' && (
    <>
      <rect x="2" y="4" width="20" height="14" rx="2" />
      <line x1="8" y1="21" x2="16" y2="21" />
      <line x1="12" y1="18" x2="12" y2="21" />
    </>
  )}
  {name === 'microwave' && (
    <>
      <rect x="2" y="5" width="20" height="14" rx="2" />
      <rect x="5" y="8" width="9" height="8" rx="1" />
      <line x1="17" y1="9" x2="19" y2="9" />
      <line x1="17" y1="12" x2="19" y2="12" />
      <line x1="17" y1="15" x2="19" y2="15" />
    </>
  )}
  {name === 'phone' && (
    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.36 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.34 1.85.573 2.81.7A2 2 0 0122 16.92z" />
  )}
  {name === 'whatsapp' && (
    <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" />
  )}
  {name === 'shield' && (
    <>
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      <path d="M9 12l2 2 4-4" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="10" />
      <polyline points="12 6 12 12 16 14" />
    </>
  )}
  {name === 'wrench' && (
    <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z" />
  )}
  {name === 'check-circle' && (
    <>
      <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
      <polyline points="22 4 12 14.01 9 11.01" />
    </>
  )}
  {name === 'map-pin' && (
    <>
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
      <circle cx="12" cy="10" r="3" />
    </>
  )}
  {name === 'users' && (
    <>
      <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
      <circle cx="9" cy="7" r="4" />
      <path d="M23 21v-2a4 4 0 00-3-3.87" />
      <path d="M16 3.13a4 4 0 010 7.75" />
    </>
  )}
  {name === 'tool' && (
    <>
      <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z" />
    </>
  )}
  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </>
  )}
  {name === 'alert-triangle' && (
    <>
      <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
      <line x1="12" y1="9" x2="12" y2="13" />
      <line x1="12" y1="17" x2="12.01" y2="17" />
    </>
  )}
  {name === 'info' && (
    <>
      <circle cx="12" cy="12" r="10" />
      <line x1="12" y1="16" x2="12" y2="12" />
      <line x1="12" y1="8" x2="12.01" y2="8" />
    </>
  )}
  {name === 'arrow-left' && (
    <>
      <line x1="19" y1="12" x2="5" y2="12" />
      <polyline points="12 19 5 12 12 5" />
    </>
  )}
</svg>
