---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE, CITIES } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'تماس با آمل سرویس',
  url: `${SITE.domain}/contact/`,
  mainEntity: {
    '@type': 'LocalBusiness',
    name: 'آمل سرویس',
    telephone: SITE.phone,
    url: SITE.domain,
  },
};
---

<Layout
  title="تماس با آمل سرویس | ثبت درخواست تعمیر لوازم خانگی"
  description="برای ثبت درخواست تعمیر لوازم خانگی در آمل و شهرهای اطراف با شماره 09032486073 تماس بگیرید یا در واتساپ پیام بدهید."
  jsonLd={jsonLd}
>
  <Breadcrumb items={[{ label: 'تماس' }]} />

  <!-- Hero -->
  <section class="container-app pt-6 md:pt-8">
    <div class="mx-auto max-w-3xl space-y-5 text-center">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-primary text-white shadow-lg">
        <ServiceIcon name="phone" class="h-8 w-8" />
      </div>
      <h1 class="text-2xl font-extrabold leading-tight text-foreground md:text-3xl lg:text-4xl">تماس با آمل سرویس</h1>
      <p class="text-base leading-relaxed text-muted-foreground md:text-lg">
        برای ثبت درخواست تعمیر لوازم خانگی، کافی است با شماره {SITE.phoneDisplay} تماس بگیرید یا در واتساپ پیام بدهید. پس از توضیح مشکل دستگاه و شهر شما، زمان مناسب برای عیب‌یابی هماهنگ می‌شود.
      </p>
    </div>
  </section>

  <!-- Contact Methods -->
  <section class="container-app section-pad">
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-5 sm:grid-cols-2">
      <a href={SITE.telLink} class="group flex flex-col items-center gap-4 rounded-2xl border-2 border-accent/20 bg-accent/5 p-8 text-center shadow-sm transition-all hover:border-accent hover:shadow-md">
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-accent text-white shadow-lg">
          <ServiceIcon name="phone" class="h-8 w-8" />
        </div>
        <div>
          <h2 class="text-xl font-bold text-foreground">تماس مستقیم</h2>
          <p class="mt-1 text-sm text-muted-foreground">سریع‌ترین راه برای ثبت درخواست</p>
        </div>
        <span class="text-2xl font-extrabold text-accent group-hover:text-orange-600" dir="ltr">تماس با آمل سرویس: {SITE.phoneDisplay}</span>
        <span class="rounded-lg bg-accent px-6 py-2.5 text-sm font-bold text-white transition-colors group-hover:bg-orange-600">تماس بگیرید</span>
      </a>

      <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center gap-4 rounded-2xl border-2 border-green-200 bg-green-50 p-8 text-center shadow-sm transition-all hover:border-green-500 hover:shadow-md">
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-green-600 text-white shadow-lg">
          <ServiceIcon name="whatsapp" class="h-8 w-8" />
        </div>
        <div>
          <h2 class="text-xl font-bold text-foreground">واتساپ</h2>
          <p class="mt-1 text-sm text-muted-foreground">پیام بدهید و مشکل دستگاه را توضیح دهید</p>
        </div>
        <span class="text-2xl font-extrabold text-green-700" dir="ltr">تماس با آمل سرویس: {SITE.phoneDisplay}</span>
        <span class="rounded-lg bg-green-600 px-6 py-2.5 text-sm font-bold text-white transition-colors group-hover:bg-green-700">ارسال پیام</span>
      </a>
    </div>
  </section>

  <!-- How to Request -->
  <section class="bg-muted/50 py-12 md:py-16">
    <div class="container-app">
      <SectionHeading title="روش ثبت درخواست" subtitle="برای ثبت درخواست تعمیر، این مراحل را دنبال کنید" center />
      <div class="mx-auto max-w-3xl space-y-4">
        <div class="flex items-start gap-4 rounded-lg border border-border bg-card p-5 shadow-sm">
          <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-accent text-sm font-bold text-white">۱</div>
          <div>
            <h3 class="font-bold text-foreground">تماس یا پیام</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">با شماره {SITE.phoneDisplay} تماس بگیرید یا در واتساپ پیام بدهید. نوع دستگاه و مشکل آن را توضیح دهید.</p>
          </div>
        </div>
        <div class="flex items-start gap-4 rounded-lg border border-border bg-card p-5 shadow-sm">
          <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-white">۲</div>
          <div>
            <h3 class="font-bold text-foreground">ذکر شهر و منطقه</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">شهر و منطقه محل دستگاه خود را ذکر کنید تا امکان رسیدن بررسی و زمان هماهنگ شود.</p>
          </div>
        </div>
        <div class="flex items-start gap-4 rounded-lg border border-border bg-card p-5 shadow-sm">
          <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white">۳</div>
          <div>
            <h3 class="font-bold text-foreground">هماهنگی زمان</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">زمان مناسب برای عیب‌یابی در محل هماهنگ می‌شود و دستگاه شما بررسی می‌گردد.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="container-app section-pad">
    <SectionHeading title="مناطق تحت پوشش" subtitle="خدمات در این شهرها و مناطق اطراف ارائه می‌شود" center />
    <div class="flex flex-wrap items-center justify-center gap-3">
      {CITIES.map((city) => (
        <a href={`/${city.slug}/`} class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground/80 transition-colors hover:border-secondary hover:text-secondary">
          <ServiceIcon name="map-pin" class="h-4 w-4" />
          {city.name}
        </a>
      ))}
    </div>
  </section>
</Layout>
