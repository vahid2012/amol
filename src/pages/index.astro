---
import Layout from '../layouts/Layout.astro';
import { SITE, SERVICES, CITIES, BRANDS, FAQS_HOME, ALL_BLOG_POSTS as BLOG_POSTS } from '../data/site';
import ServiceCard from '../components/ServiceCard.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import ServiceImage from '../components/ServiceImage.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import FAQ from '../components/FAQ.astro';

const persianMonths: Record<string, string> = {
  '01': 'فروردین', '02': 'اردیبهشت', '03': 'خرداد', '04': 'تیر',
  '05': 'مرداد', '06': 'شهریور', '07': 'مهر', '08': 'آبان',
  '09': 'آذر', '10': 'دی', '11': 'بهمن', '12': 'اسفند',
};

function formatDate(dateStr: string): string {
  const [y, m] = dateStr.split('-');
  return `${persianMonths[m] || ''} ${y}`;
}

const recentPosts = BLOG_POSTS.slice(0, 4);

const processSteps = [
  { icon: 'phone', title: 'تماس یا پیام', desc: 'با شماره ما تماس بگیرید یا در واتساپ مشکل دستگاه خود را توضیح دهید.' },
  { icon: 'search', title: 'عیب‌یابی', desc: 'دستگاه شما در محل بررسی و عیب‌یابی می‌شود تا مشکل دقیق تشخیص داده شود.' },
  { icon: 'wrench', title: 'تعمیر', desc: 'پس از اعلام هزینه، تعمیر لازم انجام می‌شود و قطعات معیوب تعویض می‌گردند.' },
  { icon: 'check-circle', title: 'تست و تحویل', desc: 'پس از تعمیر، دستگاه تست می‌شود و در صورت کارکرد صحیح تحویل داده می‌شود.' },
];

const advantages = [
  { icon: 'search', title: 'عیب‌یابی اصولی', desc: 'مشکل دستگاه پیش از تعمیر به‌دقت تشخیص داده می‌شود.' },
  { icon: 'wrench', title: 'تعمیر تخصصی', desc: 'هر دستگاه توسط فرد آشنا به آن نوع دستگاه بررسی می‌شود.' },
  { icon: 'map-pin', title: 'خدمات در منطقه', desc: 'در آمل و شهرهای اطراف، به‌شرط امکان رسیدن به محل.' },
  { icon: 'phone', title: 'ثبت درخواست ساده', desc: 'با یک تماس یا پیام واتساپ، درخواست شما ثبت می‌شود.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'آمل سرویس',
  alternateName: 'Amol Service',
  url: SITE.domain,
  telephone: SITE.phone,
  description: SITE.description,
  areaServed: CITIES.map((c) => c.name),
  knowsAbout: SERVICES.map((s) => s.title),
};
---

<Layout
  title="تعمیر لوازم خانگی در آمل و شهرهای اطراف | آمل سرویس"
  description={SITE.description}
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary via-primary to-[#0f1f3a]">
    <div class="absolute inset-0 opacity-10">
      <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
        <defs>
          <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
            <path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100" height="100" fill="url(#grid)" />
      </svg>
    </div>
    <div class="container-app relative grid grid-cols-1 items-center gap-8 py-12 md:py-16 lg:grid-cols-2 lg:py-24">
      <div class="space-y-6 text-center lg:text-right">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-blue-200">
          <span class="flex h-2 w-2 rounded-full bg-green-400"></span>
          خدمات تعمیر لوازم خانگی در آمل و منطقه
        </span>
        <h1 class="text-3xl font-extrabold leading-tight text-white md:text-4xl lg:text-5xl">
          تعمیر لوازم خانگی در آمل و شهرهای اطراف
        </h1>
        <p class="text-base leading-relaxed text-blue-100/80 md:text-lg">
          آمل سرویس در زمینه عیب‌یابی و تعمیر لوازم خانگی فعالیت می‌کند. شما می‌توانید برای ثبت درخواست تعمیر یخچال، لباسشویی، تلویزیون، کولر گازی، پکیج و مایکروویو با شماره {SITE.phoneDisplay} تماس بگیرید یا در واتساپ پیام بدهید.
        </p>
        <div class="flex flex-col items-center gap-3 sm:flex-row lg:justify-start">
          <a href={SITE.telLink} class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-base font-bold text-white shadow-lg transition-colors hover:bg-orange-600 sm:w-auto">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            تماس با آمل سرویس: <span dir="ltr">{SITE.phoneDisplay}</span>
          </a>
          <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border-2 border-green-400 bg-green-500/90 px-6 py-3.5 text-base font-bold text-white shadow-lg transition-colors hover:bg-green-600 sm:w-auto">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            واتساپ
          </a>
        </div>
      </div>
      <div class="hidden lg:block">
        <ServiceImage type="hero" alt="تعمیر لوازم خانگی در آمل - یخچال، لباسشویی، کولر گازی و تلویزیون" class="h-[400px] w-full" />
      </div>
    </div>
    <div class="border-t border-white/10 bg-white/5">
      <div class="container-app grid grid-cols-2 gap-4 py-5 md:grid-cols-4 md:py-6">
        <div class="flex items-center gap-2 text-center text-white md:flex-row md:text-right">
          <ServiceIcon name="search" class="h-6 w-6 flex-shrink-0 text-accent" />
          <span class="text-xs font-medium text-blue-100 md:text-sm">عیب‌یابی اصولی</span>
        </div>
        <div class="flex items-center gap-2 text-center text-white md:flex-row md:text-right">
          <ServiceIcon name="wrench" class="h-6 w-6 flex-shrink-0 text-accent" />
          <span class="text-xs font-medium text-blue-100 md:text-sm">تعمیر تخصصی</span>
        </div>
        <div class="flex items-center gap-2 text-center text-white md:flex-row md:text-right">
          <ServiceIcon name="map-pin" class="h-6 w-6 flex-shrink-0 text-accent" />
          <span class="text-xs font-medium text-blue-100 md:text-sm">در آمل و اطراف</span>
        </div>
        <div class="flex items-center gap-2 text-center text-white md:flex-row md:text-right">
          <ServiceIcon name="phone" class="h-6 w-6 flex-shrink-0 text-accent" />
          <span class="text-xs font-medium text-blue-100 md:text-sm">ثبت درخواست ساده</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="container-app section-pad">
    <SectionHeading
      title="خدمات تعمیر آمل سرویس"
      subtitle="عیب‌یابی و تعمیر انواع لوازم خانگی و تجهیزات الکترونیکی در آمل و شهرهای اطراف"
      center
    />
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {SERVICES.map((service) => (
        <ServiceCard
          title={service.title}
          short={service.short}
          href={`/${service.slug}/`}
          icon={service.icon}
        />
      ))}
    </div>
  </section>

  <!-- Brands Section -->
  <section class="bg-muted/50 py-12 md:py-16">
    <div class="container-app">
      <SectionHeading
        title="برندهای قابل تعمیر"
        subtitle="تعمیر و عیب‌یابی لوازم خانگی برندهای مختلف داخلی و خارجی"
        center
      />
      <div class="flex flex-wrap items-center justify-center gap-3">
        {BRANDS.map((brand) => (
          <span class="rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground/80 shadow-sm">
            {brand}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Areas Section -->
  <section id="areas" class="container-app section-pad">
    <SectionHeading
      title="مناطق تحت پوشش"
      subtitle="خدمات تعمیر لوازم خانگی در آمل و شهرهای اطراف، به‌شرط امکان رسیدن به محل دستگاه"
      center
    />
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {CITIES.map((city) => (
        <a
          href={`/${city.slug}/`}
          class="group flex items-center gap-3 rounded-xl border border-border bg-card p-4 shadow-sm transition-all hover:border-secondary/40 hover:shadow-md"
        >
          <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-primary/5 text-primary transition-colors group-hover:bg-secondary/10 group-hover:text-secondary">
            <ServiceIcon name="map-pin" class="h-5 w-5" />
          </div>
          <div>
            <p class="font-bold text-foreground group-hover:text-secondary">{city.name}</p>
            <p class="text-xs text-muted-foreground">تعمیر لوازم خانگی</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Process Section -->
  <section class="bg-muted/50 py-12 md:py-16">
    <div class="container-app">
      <SectionHeading
        title="فرآیند ثبت درخواست تعمیر"
        subtitle="با چند مرحله ساده، درخواست تعمیر دستگاه خود را ثبت کنید"
        center
      />
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step, index) => (
          <div class="relative flex flex-col items-center text-center">
            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-primary text-white shadow-lg">
              <ServiceIcon name={step.icon} class="h-7 w-7" />
            </div>
            {index < processSteps.length - 1 && (
              <div class="absolute right-[-50%] top-8 hidden h-0.5 w-full bg-border lg:block" style="display:none"></div>
            )}
            <span class="mt-2 text-xs font-bold text-accent">مرحله {index + 1}</span>
            <h3 class="mt-2 text-lg font-bold text-foreground">{step.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Advantages Section -->
  <section class="container-app section-pad">
    <SectionHeading
      title="چرا آمل سرویس؟"
      subtitle="تلاش می‌کنیم خدمات تعمیراتی قابل اعتماد و اصولی ارائه دهیم"
      center
    />
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {advantages.map((adv) => (
        <div class="flex flex-col items-start gap-3 rounded-xl border border-border bg-card p-6 shadow-sm">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-secondary/10 text-secondary">
            <ServiceIcon name={adv.icon} class="h-6 w-6" />
          </div>
          <h3 class="text-base font-bold text-foreground">{adv.title}</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">{adv.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQ items={FAQS_HOME} />

  <!-- Blog Section -->
  <section class="bg-muted/50 py-12 md:py-16">
    <div class="container-app">
      <SectionHeading
        title="مقالات آموزشی"
        subtitle="نکات کاربردی برای نگهداری و عیب‌یابی اولیه لوازم خانگی"
        center
      />
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {recentPosts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="group flex flex-col overflow-hidden rounded-xl border border-border bg-card shadow-sm transition-all hover:shadow-md">
            <div class="aspect-[3/2] bg-primary/5">
              <ServiceImage type={post.image} alt={post.title} class="h-full w-full" />
            </div>
            <div class="flex flex-1 flex-col p-4">
              <span class="mb-2 inline-flex w-fit rounded-md bg-secondary/10 px-2.5 py-1 text-xs font-semibold text-secondary">{post.category}</span>
              <h3 class="text-sm font-bold leading-snug text-foreground group-hover:text-secondary">{post.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-muted-foreground line-clamp-2">{post.excerpt}</p>
              <span class="mt-3 text-xs text-muted-foreground">{formatDate(post.date)}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/blog/" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:border-secondary hover:text-secondary">
          مشاهده همه مقالات
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection />
</Layout>
